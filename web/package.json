    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "vue-tsc": "3.1.1"
  }
}
