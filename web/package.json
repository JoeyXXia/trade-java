{
  "name": "commerceflow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.0",
  "overrides": {
    "vite": "$vite"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
